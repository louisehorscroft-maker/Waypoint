---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Waypoint.">
  <section class="section">
    <div class="container">
      <h1>Get in touch</h1>
      <p class="lead">
        We would love to hear from you. Contact details below are placeholders and will be updated before
        launch.
      </p>
      <p>You can reach us in the following ways.</p>
      <ul>
        <li><strong>Email:</strong> Write to <a href="mailto:hello@example.com">hello@example.com</a></li>
        <li><strong>Phone:</strong> Call 01234 567890</li>
        <li><strong>Office hours:</strong> Monday to Friday, 9am to 5pm</li>
      </ul>
    </div>
  </section>
</BaseLayout>
