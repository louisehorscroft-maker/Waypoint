---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import InfoPanel from '../components/InfoPanel.astro';
import RouteCard from '../components/RouteCard.astro';
import PageHero from '../components/PageHero.astro';
import CardGroup from '../components/CardGroup.astro';
import Card from '../components/Card.astro';
import Illustration from '../components/Illustration.astro';
import PhotoFrame from '../components/PhotoFrame.astro';

// Copy: rewritten from content-source/waypoint-content-v1.md, section "1 Home".
// Wes's WEBSITE COPY is the framework; every fact here comes from it.

/** Meet Wes: a real photograph of Wes only (supplied by Lou, placeholder until a final photo). */
const wesImage = {
  src: '/images/wes-horscroft-480.webp',
  srcset: '/images/wes-horscroft-480.webp 480w, /images/wes-horscroft-960.webp 960w',
  alt: 'Wes Horscroft, founder of Waypoint',
};

const keyFacts = [
  { label: 'Planned hours', value: '9:00am–2:30pm', icon: 'calendar' as const },
  { label: 'Ages', value: '8–16, depending on individual and group suitability', icon: 'people' as const },
  { label: 'Location', value: 'Shoreham-by-Sea', icon: 'pin' as const },
  {
    label: 'First term',
    value: 'Practical indoor and land-based outdoor learning',
    icon: 'tree' as const,
  },
];
---

<BaseLayout
  title="Alternative provision in Shoreham-by-Sea"
  description="Waypoint is a new small-group provision in Shoreham-by-Sea where young people aged 8–16 will create, explore, solve problems and work together."
>
  <PageHero
    title="Alternative provision in Shoreham-by-Sea"
    strapline="Hands-on, small-group learning days for young people aged 8–16."
  />

  <Section id="about" title="About Waypoint" strapline="A day of making, building and working together." drawing="building" drawingLabel="Line drawing of two stick people carrying a plank, with a toolbox">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          Imagine a team building a basecamp, setting off a giant chain reaction or inventing a whole village.
          Waypoint is a new small-group provision being developed in Shoreham-by-Sea, where young people aged 8–16
          will create, explore, solve problems and work together.
        </p>
        <p>
          Waypoint offers two routes. Schools can arrange a funded place for a pupil, and home-educating families can
          enquire directly about a home education place. Whichever route a young person takes, the day is built
          around worthwhile activities, encouragement and room for different strengths, and we look carefully at each
          young person's needs before any place is offered.
        </p>
      </div>
      <div class="button-row">
        <Button href="/about/">About Waypoint</Button>
      </div>
    </Fragment>
  </Section>

  <Section id="key-facts" title="Key facts" strapline="Small groups in Shoreham-by-Sea, for ages 8–16." drawing="map-pin" drawingLabel="Line drawing of a dotted path leading to a map pin by the sea" drawingSide="left">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          Waypoint is preparing to open. This is what we are planning, and we will confirm the venue, opening date,
          practical arrangements and available places before any start is agreed.
        </p>
      </div>
    </Fragment>
    <div class="key-facts">
      <InfoPanel facts={keyFacts} />
    </div>
  </Section>

  <Section id="find-your-way" title="Who Waypoint is for" strapline="Schools, local authorities and families." drawing="signpost" drawingLabel="Line drawing of a stick person looking up at a signpost">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          Whether you work in a school or local authority, or care for a young person, start with the route that
          fits.
        </p>
      </div>
    </Fragment>
    <CardGroup columns={2}>
      <RouteCard title="Schools and SENCos" href="/for-schools/">
        See how a school-funded place works, from assessing Waypoint as a provider to considering an individual
        pupil, with purposeful learning and regular reporting.
      </RouteCard>
      <RouteCard title="Local authorities" href="/for-local-authorities/">
        Early conversations are welcome with education and inclusion teams, commissioners and Virtual Schools about
        what a placement could add to a young person's wider plan.
      </RouteCard>
      <RouteCard title="Parents and carers" href="/parents-and-carers/">
        Picture your child's day, meet Wes and see the two ways to explore a place, through school or as a
        home-educating family.
      </RouteCard>
      <RouteCard title="Home education" href="/home-education/">
        Practical enrichment, group projects and creative challenges for home-educated young people. Families can
        enquire directly, with no school referral needed.
      </RouteCard>
      <p slot="footer" class="secondary-route">
        <a href="/for-young-people/">For young people</a>
      </p>
    </CardGroup>
  </Section>

  <Section id="activities" title="Projects and activities" strapline="What could you make happen?">
    <Fragment slot="intro">
    <div class="prose">
      <p>
        Build a basecamp from ropes and materials, send a ball through a giant chain reaction or create a whole
        Survival Village. Dream up an idea, draw the plan, build it, test it and work out what could be better.
      </p>
      <p>
        The projects are fun in their own right, and along the way young people practise practical skills,
        teamwork, communication and problem-solving. They are examples from our developing activity bank, not a
        fixed weekly timetable.
      </p>
    </div>
    </Fragment>
    <div class="drawings">
      <Illustration name="campfire" label="Line drawing of stick people sitting and standing round a campfire" />
      <Illustration name="chain-reaction" label="Line drawing of a ball rolling down a ramp into a row of dominoes" />
      <Illustration name="survival-village" label="Line drawing of a small village of huts, a tipi with a flag and a campfire" />
    </div>
    <div class="button-row">
      <Button href="/about/#activities">Explore the activities</Button>
    </div>
  </Section>

  <Section id="learning" title="Learning at Waypoint" strapline="The fun matters. So does the learning." drawing="idea" drawingLabel="Line drawing of a stick person with a lightbulb idea, sketching at an easel" drawingSide="left">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          When young people have something meaningful to make or solve, different strengths, interests and ways of
          contributing come through. Our aim is to give every young person engaging experiences, thoughtful guidance
          and a real part to play.
        </p>
        <h3>School-funded places</h3>
        <p>
          We agree a small number of individual goals with the school and family, drawing on the support plans
          already in place.
        </p>
        <h3>Home education</h3>
        <p>
          For young people who are home educated and want something extra in their week, Waypoint offers days of
          hands-on projects and creative challenges alongside other young people.
        </p>
      </div>
    </Fragment>
  </Section>

  <Section id="feedback" title="Feedback for schools and families" strapline="A clear written report every week." drawing="report" drawingLabel="Line drawing of a report sheet with ticks and a pencil">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          School-funded places include a weekly report for the school and family. It tells you what the young person
          did, what helped and what to try next.
        </p>
      </div>
    </Fragment>
    <CardGroup columns={3}>
      <Card title="What they did" icon="clipboard">
        The activity, what the young person did and how it went.
      </Card>
      <Card title="What helped" icon="heart">
        The support they had and anything they still found hard.
      </Card>
      <Card title="What to try next" icon="arrow">
        One or two realistic next steps, plus ideas the school might want to try.
      </Card>
    </CardGroup>
    <div class="prose feedback__more">
      <p>
        We include the young person's own view of their day where we can. There is a check-in after the first two
        sessions, then fuller reviews at around weeks 4, 8 and 12.
      </p>
    </div>
    <div class="button-row">
      <Button href="/for-schools/">How it works for schools</Button>
    </div>
  </Section>

  <Section
    id="meet-wes"
    title="Meet Wes"
    strapline="Director of Rugby, PE teacher and GB paddler."
    drawingSide="left"
  >
    <PhotoFrame
      slot="photo"
      src={wesImage.src}
      srcset={wesImage.srcset}
      sizes="(min-width: 48rem) 18rem, 16rem"
      alt={wesImage.alt}
      width={480}
      height={588}
      ratio="4 / 5"
      position="50% 30%"
    />
    <Fragment slot="intro">
      <div class="prose">
        <p>
          Waypoint is founded by Wes Horscroft, a rugby director, PE teacher and international paddler who knows how to
          help young people learn new skills, work as a team and take on a real challenge.
        </p>
        <p>
          Wes built the Newman Rugby Academy in Hove from the ground up and won it RFU ACE status, a place in England
          Rugby's programme for the most promising young players. That takes years of patient coaching and getting the
          best out of young people, which is exactly what Waypoint is about.
        </p>
        <p>
          At Waypoint he brings all of that to practical learning. You don't need to be sporty to join in. Designing,
          making and trying something new all count.
        </p>
      </div>
    </Fragment>
    <CardGroup columns={3}>
      <Card title="Director of Rugby">
        At Cardinal Newman Catholic School in Hove, where Wes set up the Newman Rugby Academy and gained it RFU ACE
        status.
      </Card>
      <Card title="GB paddler">
        Raced for Great Britain at the 2024 IVF Va'a World Sprint Championships in Hawaii.
      </Card>
      <Card title="Teacher and coach">
        Teaching PE since 2007, and coaching young people to learn new skills and work together.
      </Card>
    </CardGroup>
  </Section>

  <Section id="get-in-touch" title="Get in touch" strapline="Start with a conversation." brand drawing="chat" drawingLabel="Line drawing of two stick people chatting, with speech bubbles">
    <Fragment slot="intro">
      <div class="prose">
        <p>
          Whether you're a SENCo considering a pupil, a parent exploring options or a home educator looking for
          something new, you're welcome to ask us anything. We'll explain the plans, help you find the right route and be
          clear about what is still being finalised.
        </p>
      </div>
      <div class="button-row">
        <Button href="/contact/" variant="accent">Get in touch</Button>
      </div>
    </Fragment>
  </Section>
</BaseLayout>

<style>
  .key-facts {
    margin-top: 1.5rem;
  }

  .secondary-route {
    font-weight: 600;
  }

  .feedback__more {
    margin-top: 1.5rem;
  }

  .secondary-route a::after {
    content: ' \2192';
  }

  .prose h3 {
    margin-top: 1.75rem;
  }

  /* Line drawings of the example projects, in a pale tinted strip */
  .drawings {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--box-bg);
  }

  @media (min-width: 48rem) {
    .drawings {
      gap: 2.5rem;
      padding: 1.5rem 2.5rem;
    }
  }

</style>
