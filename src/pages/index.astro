---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="section">
    <div class="container">
      <h1>Find your direction</h1>
      <p class="lead">
        Waypoint is a new business helping people and organisations plan their next move. This is placeholder
        copy, ready to be replaced with the real story.
      </p>
      <a class="button" href="/contact/">Get in touch</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Why Waypoint</h2>
      <p>Three short reasons to work with us, each with a single placeholder paragraph.</p>
      <div class="grid">
        <article class="card">
          <h3>Clear thinking</h3>
          <p>We cut through the noise and focus on what matters most, so every decision has a purpose.</p>
        </article>
        <article class="card">
          <h3>Practical plans</h3>
          <p>Our recommendations are built to be used, with realistic steps your team can act on straight away.</p>
        </article>
        <article class="card">
          <h3>Lasting results</h3>
          <p>We measure what changes, and around 90% of our placeholder clients would come back again.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
