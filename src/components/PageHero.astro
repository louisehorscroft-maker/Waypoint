---
import Button from './Button.astro';
import { contactLink } from '../data/navigation';

interface Props {
  /** Keyword-led H1, short, sentence case */
  title: string;
  /** One-line strapline under the H1 */
  strapline: string;
  /** Hide the contact button, for example on the contact page itself */
  hideCta?: boolean;
}

const { title, strapline, hideCta = false } = Astro.props;

// Keep number ranges such as 8–16 on one line
const keepRanges = (text: string) => text.replace(/(\d)–(\d)/g, '$1\u2060–\u2060$2');
---

<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <h1 id="page-title" class="page-hero__title">{title}</h1>
    <p class="page-hero__strapline">{keepRanges(strapline)}</p>
    {
      !hideCta && (
        <div class="page-hero__cta">
          <Button href={contactLink.href} variant="accent">
            {contactLink.label}
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    background: var(--colour-brand);
    color: var(--colour-on-brand);
    padding: 2.5rem 0;
    border-top: 6px solid var(--colour-accent);
    border-bottom: 6px solid var(--colour-accent);
  }

  .page-hero__title {
    max-width: 40rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.875rem, 4.5vw, 2.75rem);
  }

  .page-hero__strapline {
    max-width: 40rem;
    margin: 0;
    font-size: clamp(1.125rem, 2.2vw, 1.3125rem);
  }

  .page-hero__cta {
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .page-hero {
      padding: 3.5rem 0;
    }
  }
</style>
