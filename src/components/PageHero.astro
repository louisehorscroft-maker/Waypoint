---
import Button from './Button.astro';
import KeepTogether from './KeepTogether.astro';
import { contactLink } from '../data/navigation';

interface Props {
  /** Keyword-led H1, short, sentence case */
  title: string;
  /** One-line strapline under the H1 */
  strapline: string;
  /** Hide the contact button, for example on the contact page itself */
  hideCta?: boolean;
}

const { title, strapline, hideCta = false } = Astro.props;

---

<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <h1 id="page-title" class="page-hero__title">
      <KeepTogether text={title} />
    </h1>
    <p class="page-hero__strapline">
      <KeepTogether text={strapline} />
    </p>
    {
      !hideCta && (
        <div class="page-hero__cta">
          <Button href={contactLink.href} variant="accent">
            {contactLink.label}
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--colour-brand);
    color: var(--colour-on-brand);
    padding: 2.5rem 0;
    border-bottom: 6px solid var(--colour-accent);
  }

  /* Faded Waypoint mark (logo image only, no wordmark) set at a diagonal.
     Decorative, so it is a CSS background and hidden from screen readers. */
  .page-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -12rem;
    width: 46rem;
    aspect-ratio: 1490 / 400;
    background: url('/images/waypoint-mark-cream.webp') no-repeat center / contain;
    opacity: 0.1;
    transform: translateY(-50%) rotate(-18deg);
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .page-hero::before {
      opacity: 0.14;
      right: -6rem;
      width: 56rem;
    }
  }

  @media (min-width: 90rem) {
    .page-hero::before {
      right: 2rem;
      width: 62rem;
    }
  }

  .page-hero__title {
    color: var(--colour-on-brand);
    max-width: 40rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-h1);
  }

  .page-hero__strapline {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-strapline);
    line-height: 1.3;
  }

  .page-hero__cta {
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .page-hero {
      padding: 3.5rem 0;
    }
  }
</style>
