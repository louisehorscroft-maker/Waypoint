---
import type { HTMLAttributes } from 'astro/types';
import KeepTogether from './KeepTogether.astro';
import Illustration, { type IllustrationName } from './Illustration.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Anchor id, used for in-page links such as /contact#visits */
  id?: string;
  /** Section heading: a short, keyword-friendly label, rendered as a small H2 */
  title?: string;
  /** Big text directly under the H2. Every H2 needs one */
  strapline?: string;
  /** Blue background, for occasional calls to action. Use the accent button inside */
  brand?: boolean;
  /**
   * Line drawing shown opposite the heading, strapline and intro (the `intro`
   * slot). Its box stretches to the same height as that text.
   */
  drawing?: IllustrationName;
  /** Describes the drawing for screen readers */
  drawingLabel?: string;
  /** Which side the drawing sits on from tablet up; alternate down the page */
  drawingSide?: 'right' | 'left';
}

const {
  id,
  title,
  strapline,
  brand = false,
  drawing,
  drawingLabel = '',
  drawingSide = 'right',
  class: className,
  ...rest
} = Astro.props;
const headingId = id && title ? `${id}-heading` : undefined;
/** A real photo (a PhotoFrame in slot="photo") can sit opposite the heading instead of a drawing */
const hasPhoto = Astro.slots.has('photo');
const hasArt = Boolean(drawing) || hasPhoto;
---

<section
  id={id}
  class:list={['section', { 'section--brand': brand }, className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="container">
    <div class:list={['section-head', { 'section-head--drawing': hasArt, 'section-head--left': drawingSide === 'left' }]}>
      <div class="section-head__text">
        {title && <h2 id={headingId}>{title}</h2>}
        {strapline && <p class="section-strapline"><KeepTogether text={strapline} /></p>}
        <slot name="intro" />
      </div>
      {
        drawing && (
          <div class="section-head__art">
            <Illustration name={drawing} label={drawingLabel} />
          </div>
        )
      }
      {
        !drawing && hasPhoto && (
          <div class="section-head__photo">
            <slot name="photo" />
          </div>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .section-head__text > :global(:last-child) {
    margin-bottom: 0;
  }

  /* No drawing or photo beside the heading: let the intro run the full width of the page */
  .section-head:not(.section-head--drawing) :global(.prose),
  .section-head:not(.section-head--drawing) :global(.section-strapline) {
    max-width: none;
  }

  /* A strapline with no intro after it keeps its usual gap before the content below */
  .section-head__text > :global(.section-strapline:last-child) {
    margin-bottom: 1rem;
  }

  /* Drawing box below the text on phones, kept compact */
  .section-head--drawing {
    display: grid;
    gap: 1.5rem;
  }

  /* Centred under the text on phones */
  .section-head__art {
    position: relative;
    width: 100%;
    height: 11rem;
    max-width: 18rem;
    justify-self: center;
    border-radius: var(--radius);
    background: var(--box-bg);
  }

  /* The drawing fits inside the box, whatever the box's height */
  .section-head__art :global(.illustration) {
    position: absolute;
    inset: 1rem;
    width: calc(100% - 2rem);
    height: calc(100% - 2rem);
  }

  .section-head__photo {
    max-width: 16rem;
    align-self: center;
    justify-self: center;
  }

  :global(.section--brand) .section-head__art {
    background: transparent;
  }

  :global(.section--brand) .section-head__art :global(.illustration) {
    color: var(--colour-on-brand);
  }

  /* From tablet up: drawing opposite the text, its box the same height */
  @media (min-width: 48rem) {
    .section-head--drawing {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: 3rem;
      align-items: stretch;
    }

    .section-head--left {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }

    .section-head--left .section-head__art,
    .section-head--left .section-head__photo {
      order: -1;
    }

    .section-head__photo {
      max-width: 18rem;
      justify-self: center;
    }

    .section-head__art {
      height: auto;
      min-height: 12rem;
      max-width: none;
    }
  }
</style>
