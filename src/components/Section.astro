---
import type { HTMLAttributes } from 'astro/types';
import KeepTogether from './KeepTogether.astro';

interface Props extends HTMLAttributes<'section'> {
  /** Anchor id, used for in-page links such as /contact#visits */
  id?: string;
  /** Section heading: a short, keyword-friendly label, rendered as a small H2 */
  title?: string;
  /** Big text directly under the H2. Every H2 needs one */
  strapline?: string;
  /** Blue background, for occasional calls to action. Use the accent button inside */
  brand?: boolean;
}

const { id, title, strapline, brand = false, class: className, ...rest } = Astro.props;
const headingId = id && title ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['section', { 'section--brand': brand }, className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="container">
    {title && <h2 id={headingId}>{title}</h2>}
    {strapline && <p class="section-strapline"><KeepTogether text={strapline} /></p>}
    <slot />
  </div>
</section>
