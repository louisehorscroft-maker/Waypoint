---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  /** Anchor id, used for in-page links such as /contact#visits */
  id?: string;
  /** Optional section heading, rendered as an h2 */
  title?: string;
  /** Forest green background, for occasional calls to action. Use the accent button inside */
  brand?: boolean;
}

const { id, title, brand = false, class: className, ...rest } = Astro.props;
const headingId = id && title ? `${id}-heading` : undefined;
---

<section
  id={id}
  class:list={['section', { 'section--brand': brand }, className]}
  aria-labelledby={headingId}
  {...rest}
>
  <div class="container">
    {title && <h2 id={headingId}>{title}</h2>}
    <slot />
  </div>
</section>
