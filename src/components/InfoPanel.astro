---
import Icon, { type IconName } from './Icon.astro';

interface Fact {
  label: string;
  value: string;
  /** Optional small line icon shown before the label */
  icon?: IconName;
}

interface Props {
  title?: string;
  /** Use h2 when the panel is a top-level page section */
  headingLevel?: 'h2' | 'h3';
  /** Anchor id for in-page links */
  id?: string;
  /** Labelled facts, shown as a definition list */
  facts?: Fact[];
}

const { title, headingLevel: Heading = 'h3', id, facts = [] } = Astro.props;
const headingId = title ? `${id ?? 'info-panel'}-heading` : undefined;
---

<section class="info-panel" id={id} aria-labelledby={headingId}>
  {title && <Heading class="info-panel__title" id={headingId}>{title}</Heading>}
  {
    facts.length > 0 && (
      <dl class="info-panel__facts">
        {facts.map((fact) => (
          <div class="info-panel__fact">
            <dt>
              {fact.icon && <Icon name={fact.icon} />}
              <span>{fact.label}</span>
            </dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <slot />
</section>

<style>
  .info-panel {
    /* Pale tinted box with a coral edge */
    background: var(--box-bg);
    border-left: 4px solid var(--colour-accent);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .info-panel__facts {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .info-panel__facts:last-child {
    margin-bottom: 0;
  }

  .info-panel__fact dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .info-panel__fact dd {
    margin: 0;
  }

  @media (min-width: 40rem) {
    .info-panel__fact {
      display: grid;
      grid-template-columns: 11.5rem 1fr;
      gap: 1rem;
    }
  }

  .info-panel :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
