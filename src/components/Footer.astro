---
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__main">
      <nav aria-label="Footer">
        <ul class="site-footer__links">
          {
            footerNav.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="site-footer__copyright">&copy; {year} Waypoint</p>
    </div>
    <a href="/" class="site-footer__logo">
      <img src="/images/waypoint-logo-cream.webp" alt="Waypoint home" width="300" height="132" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--colour-brand);
    color: var(--colour-on-brand);
    font-size: 0.9375rem;
    padding: 2.5rem 0 2rem;
  }

  /* Full-width like the header: links on the left, logo hard right on the same row */
  .site-footer__inner {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .site-footer__main {
    flex: 1 1 18rem;
    max-width: 60rem;
  }

  .site-footer__logo {
    display: block;
    margin-left: auto;
    line-height: 0;
  }

  .site-footer__logo img {
    width: auto;
    height: 4.5rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 1.5rem;
  }

  @media (min-width: 36rem) {
    .site-footer__links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .site-footer__links {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Match the header's side padding on wide screens so the logos line up */
  @media (min-width: 90rem) {
    .site-footer__inner {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  .site-footer a {
    color: var(--colour-on-brand);
  }

  .site-footer a:hover {
    text-decoration-color: var(--colour-accent);
    text-decoration-thickness: 2px;
  }

  .site-footer a:focus-visible {
    outline-color: var(--colour-accent);
  }

  .site-footer__copyright {
    margin: 0;
  }
</style>
