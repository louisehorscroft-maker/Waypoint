---
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          footerNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">&copy; {year} Waypoint</p>
      <a href="/" class="site-footer__logo">
        <img src="/images/waypoint-logo-cream.webp" alt="Waypoint home" width="300" height="132" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--colour-brand);
    color: var(--colour-on-brand);
    font-size: 0.9375rem;
    padding: 2.5rem 0 2rem;
  }

  .site-footer__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(250 246 238 / 0.25);
  }

  .site-footer__logo {
    display: block;
    line-height: 0;
  }

  .site-footer__logo img {
    width: auto;
    height: 4rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 1.5rem;
  }

  @media (min-width: 36rem) {
    .site-footer__links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .site-footer__links {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .site-footer a {
    color: var(--colour-on-brand);
  }

  .site-footer a:hover {
    text-decoration-color: var(--colour-accent);
    text-decoration-thickness: 2px;
  }

  .site-footer a:focus-visible {
    outline-color: var(--colour-accent);
  }

  .site-footer__copyright {
    margin: 0;
  }
</style>
