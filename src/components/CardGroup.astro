---
interface Props {
  /** 2 for a 2x2 grid of four, 3 for groups of three or six */
  columns: 2 | 3;
}

const { columns } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

{/* Every group of boxes sits in a panel the opposite colour to the section (cream on white, white on cream); the boxes inside flip back to the section colour */}
<div class="card-group">
  <div class:list={['grid', `grid--${columns}`]}>
    <slot />
  </div>
  {
    hasFooter && (
      <div class="card-group__footer">
        <slot name="footer" />
      </div>
    )
  }
</div>

<style>
  .card-group {
    background: var(--box-bg);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  @media (min-width: 48rem) {
    .card-group {
      padding: 2rem;
    }
  }

  .card-group__footer {
    margin-top: 1.5rem;
  }

  .card-group__footer :global(p) {
    margin: 0;
  }
</style>
