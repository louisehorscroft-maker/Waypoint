---
/**
 * Simple line drawings of activities, in the logo's line style (forest green,
 * round ends, a gentle wavy ground line). Stick people are fine (Wes asked for
 * them) as long as they stay simple, with no faces or real-person detail.
 * Never draw a real session or the venue.
 */
export type IllustrationName =
  | 'basecamp'
  | 'chain-reaction'
  | 'survival-village'
  | 'campfire'
  | 'building'
  | 'map-pin'
  | 'signpost'
  | 'idea'
  | 'report'
  | 'chat'
  | 'game-studio'
  | 'day'
  | 'helping'
  | 'steps'
  | 'setting'
  | 'school'
  | 'meeting';

interface Props {
  name: IllustrationName;
  /** Accessible description of the drawing */
  label: string;
}

const { name, label } = Astro.props;
---

<svg
  class="illustration"
  viewBox="0 0 200 140"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
>
  <path class="illustration__ground" d="M8 122c22-2 38 2 60 0s40-3 62 0 40 2 62-1" />
  {
    name === 'basecamp' && (
      <>
        {/* A basecamp tent with a flag and guy ropes, between two pine trees */}
        <path d="M30 46 18 70h8L14 94h10L12 110h36L36 94h10L34 70h8z" />
        <path d="M30 110v12" />
        <path d="M62 122 105 64l43 58" />
        <path d="M105 86 95 122M105 86l10 36" />
        <path d="M105 64V50l14 5-14 5" />
        <path d="M76 103 50 120M134 103l26 17" />
        <path d="M178 66l-9 18h6l-9 18h8l-9 14h26l-9-14h8l-9-18h6z" />
        <path d="M178 116v6" />
      </>
    )
  }
  {
    name === 'chain-reaction' && (
      <>
        {/* A ball rolling down a ramp into a row of falling dominoes */}
        <circle cx="34" cy="44" r="7" />
        <path d="M16 42 82 80" />
        <path d="M74 75v47M30 50v72" />
        <path d="M14 30c4-2 8-2 11 0M10 38c4-2 8-2 11 0" />
        <path d="M88 122l8-28h6l-8 28" />
        <path d="M108 122l6-29h6l-6 29" />
        <path d="M128 122l3-30h6l-3 30" />
        <path d="M148 122V92h6v30" />
        <path d="M168 122V92h6v30" />
      </>
    )
  }
  {
    name === 'survival-village' && (
      <>
        {/* A hut, a tipi with a flag, a small shelter and a campfire */}
        <path d="M14 122V90l22-18 22 18v32" />
        <path d="M30 122v-16h12v16" />
        <path d="M72 122 98 64l26 58" />
        <path d="M92 56l12 16M104 56 92 72" />
        <path d="M98 64V36l16 6-16 6" />
        <path d="M92 122l6-18 6 18" />
        <path d="M134 122v-20l18-14 18 14v20" />
        <path d="M176 122l14-10M190 122l-14-10" />
        <path d="M183 112c-4-4-3-9 0-13 1 4 4 5 4 9s-2 5-4 4z" />
      </>
    )
  }
  {
    name === 'campfire' && (
      <>
        {/* Stick people sitting round a campfire, one waving */}
        <path d="M84 122l32-11M116 122 84 111" />
        <path d="M100 109c-9-7-8-18-1-27 2 7 10 10 10 18 0 6-4 9-9 9z" />
        <path d="M100 103c-3-3-3-7 0-10 1 3 4 4 3 7 0 2-1 3-3 3z" />
        <path d="M86 76v-4M114 74l2-4M100 66v-5" />
        <circle cx="56" cy="80" r="7" />
        <path d="M56 87v20h14l2 15M56 94l12 8" />
        <circle cx="144" cy="80" r="7" />
        <path d="M144 87v20h-14l-2 15M144 94l-12 8" />
        <circle cx="24" cy="66" r="7" />
        <path d="M24 73v28M24 101l-7 21M24 101l7 21M24 80l-12-12M24 80l9 12" />
        <circle cx="176" cy="66" r="7" />
        <path d="M176 73v28M176 101l-7 21M176 101l7 21M176 80l-10 12M176 80l10 12" />
      </>
    )
  }
  {
    name === 'building' && (
      <>
        {/* Two stick people carrying a plank, with a toolbox */}
        <circle cx="50" cy="48" r="7" />
        <path d="M50 55v37M50 92l-8 30M50 92l8 30M50 64l10 7M50 64l-8 12" />
        <circle cx="150" cy="48" r="7" />
        <path d="M150 55v37M150 92l-8 30M150 92l8 30M150 64l-10 7M150 64l8 12" />
        <rect x="56" y="68" width="88" height="7" rx="2" />
        <rect x="86" y="104" width="28" height="18" rx="2" />
        <path d="M93 104v-5h14v5M86 112h28" />
      </>
    )
  }
  {
    name === 'map-pin' && (
      <>
        {/* A dotted path to a map pin, with the sun and the sea */}
        <circle cx="38" cy="36" r="9" />
        <path d="M38 20v-4M38 56v-4M22 36h-4M58 36h-4M27 25l-3-3M49 25l3-3M27 47l-3 3M49 47l3 3" />
        <path d="M18 118c30-6 30-26 60-26s34-14 66-22" stroke-dasharray="0.5 9" />
        <path d="M150 76c-10-10-14-16-14-23a14 14 0 0 1 28 0c0 7-4 13-14 23z" />
        <circle cx="150" cy="53" r="5" />
        <path d="M118 110c4-4 8-4 12 0s8 4 12 0 8-4 12 0 8 4 12 0" />
      </>
    )
  }
  {
    name === 'signpost' && (
      <>
        {/* A stick person looking up at a signpost with three arrows */}
        <path d="M108 122V34" />
        <path d="M108 42h40l8 7-8 7h-40z" />
        <path d="M108 64H70l-8 7 8 7h38z" />
        <path d="M108 86h34l7 6-7 6h-34z" />
        <circle cx="34" cy="80" r="7" />
        <path d="M34 87v19M34 106l-7 16M34 106l7 16M34 93l14-12M34 93l-10 8" />
      </>
    )
  }
  {
    name === 'idea' && (
      <>
        {/* A stick person with a lightbulb idea, sketching at an easel */}
        <circle cx="56" cy="38" r="9" />
        <path d="M52 47h8M53 51h6M56 22v-5M42 30l-4-3M70 30l4-3" />
        <circle cx="56" cy="68" r="7" />
        <path d="M56 75v25M56 100l-8 22M56 100l8 22M56 82l20 6M56 82l-10 10" />
        <path d="M100 122l16-32M144 122l-16-32M122 90v32" />
        <rect x="92" y="50" width="60" height="40" rx="3" />
        <path d="M100 78c6-6 10-6 16 0s10 6 16 0" />
        <circle cx="134" cy="64" r="6" />
      </>
    )
  }
  {
    name === 'report' && (
      <>
        {/* A report sheet with ticks and a pencil, and a stick person pointing at it */}
        <rect x="66" y="30" width="64" height="90" rx="3" />
        <path d="M76 48l4 4 8-8M96 48h24M76 68l4 4 8-8M96 68h24M76 90h44M76 104h30" />
        <path d="M142 118l6 3 26-52-6-3z" />
        <path d="M142 118l-2 8 8-5M164 74l6 3" />
        <circle cx="32" cy="80" r="7" />
        <path d="M32 87v19M32 106l-7 16M32 106l7 16M32 93l26-10M32 93l-9 10" />
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        {/* Two stick people chatting, with speech bubbles */}
        <circle cx="62" cy="76" r="7" />
        <path d="M62 83v21M62 104l-7 18M62 104l7 18M62 90l12 8M62 90l-10 10" />
        <circle cx="138" cy="76" r="7" />
        <path d="M138 83v21M138 104l-7 18M138 104l7 18M138 90l-12 8M138 90l10 10" />
        <rect x="24" y="24" width="52" height="28" rx="9" />
        <path d="M46 52l-4 10 12-10" />
        <path d="M38 38h.5M50 38h.5M62 38h.5" />
        <rect x="120" y="30" width="56" height="26" rx="9" />
        <path d="M150 56l4 10-14-10" />
        <path d="M130 44c5-5 9-5 13 0s9 5 13 0" />
      </>
    )
  }
  {
    name === 'game-studio' && (
      <>
        {/* A screen showing a simple platform game, with two stick people */}
        <rect x="56" y="26" width="88" height="62" rx="4" />
        <path d="M100 88v16M84 104h32" />
        <path d="M66 76h24M100 64h20M126 52h10" />
        <circle cx="74" cy="68" r="4" />
        <path d="M131 34l2 5 5 1-4 3 1 5-4-3-4 3 1-5-4-3 5-1z" />
        <circle cx="26" cy="80" r="7" />
        <path d="M26 87v19M26 106l-7 16M26 106l7 16M26 93l22-10M26 93l-9 10" />
        <circle cx="174" cy="80" r="7" />
        <path d="M174 87v19M174 106l-7 16M174 106l7 16M174 93l-22-10M174 93l9 10" />
      </>
    )
  }
  {
    name === 'day' && (
      <>
        {/* The sun's path across the day, with stops along the way */}
        <path d="M20 122Q100 10 180 122" stroke-dasharray="0.5 9" />
        <circle cx="100" cy="32" r="10" />
        <path d="M100 14v-5M100 55v-5M82 32h-5M123 32h-5M87 19l-3-3M113 19l3-3M87 45l-3 3M113 45l3 3" />
        <circle cx="36" cy="102" r="4" fill="currentColor" />
        <circle cx="68" cy="75" r="4" fill="currentColor" />
        <circle cx="100" cy="66" r="4" fill="currentColor" />
        <circle cx="132" cy="75" r="4" fill="currentColor" />
        <circle cx="166" cy="102" r="4" fill="currentColor" />
      </>
    )
  }
  {
    name === 'helping' && (
      <>
        {/* An adult showing a young person how to stack blocks */}
        <circle cx="62" cy="44" r="8" />
        <path d="M62 52v38M62 90l-9 32M62 90l9 32M62 62l22 18M62 62l-12 16" />
        <circle cx="140" cy="76" r="7" />
        <path d="M140 83v19M140 102l-7 20M140 102l7 20M140 90l-18 6M140 90l9 10" />
        <rect x="90" y="108" width="20" height="14" rx="1" />
        <rect x="93" y="94" width="14" height="14" rx="1" />
        <rect x="95" y="80" width="10" height="14" rx="1" />
      </>
    )
  }
  {
    name === 'steps' && (
      <>
        {/* A winding route up to a flag: progress isn't a straight line */}
        <path d="M18 120h26v-16h18l10 10h18V82h22l-8 14h16V62h26" />
        <path d="M148 62V36l16 6-16 6" />
      </>
    )
  }
  {
    name === 'setting' && (
      <>
        {/* A building with trees and the sun */}
        <path d="M30 122V78l38-26 38 26v44" />
        <path d="M58 122v-24h20v24" />
        <rect x="40" y="84" width="12" height="10" rx="1" />
        <rect x="84" y="84" width="12" height="10" rx="1" />
        <path d="M146 58l-10 20h6l-12 22h8l-10 16h36l-10-16h8l-12-22h6z" />
        <path d="M146 116v6" />
        <circle cx="176" cy="34" r="8" />
        <path d="M176 20v-4M176 52v-4M162 34h-4M194 34h-4" />
      </>
    )
  }
  {
    name === 'school' && (
      <>
        {/* A school building with a clock, a flag and a stick person at the door */}
        <path d="M44 122V70l56-30 56 30v52" />
        <circle cx="100" cy="62" r="8" />
        <path d="M100 57v5l3 3" />
        <path d="M88 122V96h24v26" />
        <rect x="56" y="84" width="16" height="12" rx="1" />
        <rect x="128" y="84" width="16" height="12" rx="1" />
        <path d="M100 40V18l14 5-14 5" />
        <circle cx="176" cy="88" r="6" />
        <path d="M176 94v14M176 108l-6 14M176 108l6 14M176 100l-8-6M176 100l8 6" />
      </>
    )
  }
  {
    name === 'meeting' && (
      <>
        {/* Two adults and a young person round a table, talking it through */}
        <path d="M58 98h84M66 98v24M134 98v24" />
        <rect x="86" y="92" width="18" height="6" rx="1" />
        <circle cx="34" cy="58" r="7" />
        <path d="M34 65v30M34 95l-7 27M34 95l7 27M34 74l18 14M34 74l-8 14" />
        <circle cx="166" cy="58" r="7" />
        <path d="M166 65v30M166 95l-7 27M166 95l7 27M166 74l-18 14M166 74l8 14" />
        <circle cx="116" cy="70" r="6" />
        <path d="M116 76v18M116 84l-8 6M116 84l8 6" />
        <path d="M70 30h40a8 8 0 0 1 8 8v8a8 8 0 0 1-8 8H86l-8 8v-8h-8a8 8 0 0 1-8-8v-8a8 8 0 0 1 8-8z" />
        <path d="M78 42h.5M90 42h.5M102 42h.5" />
      </>
    )
  }
</svg>

<style>
  .illustration {
    display: block;
    width: 100%;
    height: auto;
    color: var(--colour-brand);
  }
</style>
