---
/**
 * Simple line drawings of activities, in the logo's line style (forest green,
 * round ends, a gentle wavy ground line). Stick people are fine (Wes asked for
 * them) as long as they stay simple, with no faces or real-person detail.
 * Never draw a real session or the venue.
 */
export type IllustrationName = 'basecamp' | 'chain-reaction' | 'survival-village' | 'campfire';

interface Props {
  name: IllustrationName;
  /** Accessible description of the drawing */
  label: string;
}

const { name, label } = Astro.props;
---

<svg
  class="illustration"
  viewBox="0 0 200 140"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
>
  <path class="illustration__ground" d="M8 122c22-2 38 2 60 0s40-3 62 0 40 2 62-1" />
  {
    name === 'basecamp' && (
      <>
        {/* A basecamp tent with a flag and guy ropes, between two pine trees */}
        <path d="M30 46 18 70h8L14 94h10L12 110h36L36 94h10L34 70h8z" />
        <path d="M30 110v12" />
        <path d="M62 122 105 64l43 58" />
        <path d="M105 86 95 122M105 86l10 36" />
        <path d="M105 64V50l14 5-14 5" />
        <path d="M76 103 50 120M134 103l26 17" />
        <path d="M178 66l-9 18h6l-9 18h8l-9 14h26l-9-14h8l-9-18h6z" />
        <path d="M178 116v6" />
      </>
    )
  }
  {
    name === 'chain-reaction' && (
      <>
        {/* A ball rolling down a ramp into a row of falling dominoes */}
        <circle cx="34" cy="44" r="7" />
        <path d="M16 42 82 80" />
        <path d="M74 75v47M30 50v72" />
        <path d="M14 30c4-2 8-2 11 0M10 38c4-2 8-2 11 0" />
        <path d="M88 122l8-28h6l-8 28" />
        <path d="M108 122l6-29h6l-6 29" />
        <path d="M128 122l3-30h6l-3 30" />
        <path d="M148 122V92h6v30" />
        <path d="M168 122V92h6v30" />
      </>
    )
  }
  {
    name === 'survival-village' && (
      <>
        {/* A hut, a tipi with a flag, a small shelter and a campfire */}
        <path d="M14 122V90l22-18 22 18v32" />
        <path d="M30 122v-16h12v16" />
        <path d="M72 122 98 64l26 58" />
        <path d="M92 56l12 16M104 56 92 72" />
        <path d="M98 64V36l16 6-16 6" />
        <path d="M92 122l6-18 6 18" />
        <path d="M134 122v-20l18-14 18 14v20" />
        <path d="M176 122l14-10M190 122l-14-10" />
        <path d="M183 112c-4-4-3-9 0-13 1 4 4 5 4 9s-2 5-4 4z" />
      </>
    )
  }
  {
    name === 'campfire' && (
      <>
        {/* Stick people sitting round a campfire, one waving */}
        <path d="M84 122l32-11M116 122 84 111" />
        <path d="M100 109c-9-7-8-18-1-27 2 7 10 10 10 18 0 6-4 9-9 9z" />
        <path d="M100 103c-3-3-3-7 0-10 1 3 4 4 3 7 0 2-1 3-3 3z" />
        <path d="M86 76v-4M114 74l2-4M100 66v-5" />
        <circle cx="56" cy="80" r="7" />
        <path d="M56 87v20h14l2 15M56 94l12 8" />
        <circle cx="144" cy="80" r="7" />
        <path d="M144 87v20h-14l-2 15M144 94l-12 8" />
        <circle cx="24" cy="66" r="7" />
        <path d="M24 73v28M24 101l-7 21M24 101l7 21M24 80l-12-12M24 80l9 12" />
        <circle cx="176" cy="66" r="7" />
        <path d="M176 73v28M176 101l-7 21M176 101l7 21M176 80l-10 12M176 80l10 12" />
      </>
    )
  }
</svg>

<style>
  .illustration {
    display: block;
    width: 100%;
    height: auto;
    color: var(--colour-brand);
  }
</style>
