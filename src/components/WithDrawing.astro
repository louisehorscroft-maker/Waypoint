---
import Illustration, { type IllustrationName } from './Illustration.astro';

/**
 * A section's text with a line drawing beside it (below it on phones).
 * Every H2 section has a drawing or a real photo.
 */
interface Props {
  drawing: IllustrationName;
  /** Describes the drawing for screen readers */
  label: string;
}

const { drawing, label } = Astro.props;
---

<div class="with-drawing">
  <div class="with-drawing__text">
    <slot />
  </div>
  <div class="with-drawing__art">
    <Illustration name={drawing} label={label} />
  </div>
</div>

<style>
  .with-drawing {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .with-drawing__text > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Kept small on phones so it doesn't add much scrolling */
  .with-drawing__art {
    max-width: 15rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    background: var(--box-bg);
  }

  /* On blue sections the drawing is cream with no box */
  :global(.section--brand) .with-drawing__art {
    background: transparent;
    padding: 0;
  }

  :global(.section--brand) .with-drawing__art :global(.illustration) {
    color: var(--colour-on-brand);
  }

  @media (min-width: 48rem) {
    .with-drawing {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: 3rem;
    }

    .with-drawing__art {
      max-width: none;
    }
  }
</style>
