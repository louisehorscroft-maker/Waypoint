---
interface Props {
  title: string;
  /** Who leads this step, shown as a "Led by" label under the title */
  who?: string;
}

const { title, who } = Astro.props;
---

<li class="step">
  <h3 class="step__title">{title}</h3>
  {who && <p class="step__who"><strong>Led by:</strong> {who}</p>}
  <div class="step__body">
    <slot />
  </div>
</li>

<style>
  .step {
    counter-increment: step;
    position: relative;
    padding-left: 3.5rem;
    min-height: 2.5rem;
  }

  .step::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--colour-brand);
    color: var(--colour-on-brand);
    font-weight: 700;
  }

  .step__who {
    margin: 0 0 0.35rem;
  }

  .step__title {
    padding-top: 0.375rem;
  }

  .step__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
