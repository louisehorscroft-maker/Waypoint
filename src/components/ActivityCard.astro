---
import Illustration, { type IllustrationName } from './Illustration.astro';

interface Props {
  title: string;
  /**
   * Real photograph only. No stock or AI-generated images of people,
   * sessions or venues. When no image is supplied the slot is not rendered.
   */
  image?: { src: string; alt: string };
  /** Line drawing shown above the text when there is no photo */
  drawing?: IllustrationName;
  drawingLabel?: string;
}

const { title, image, drawing, drawingLabel = '' } = Astro.props;
---

<article class="activity-card">
  {image && <img class="activity-card__image" src={image.src} alt={image.alt} loading="lazy" />}
  {
    !image && drawing && (
      <div class="activity-card__drawing">
        <Illustration name={drawing} label={drawingLabel} />
      </div>
    )
  }
  <div class="activity-card__body">
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
</article>

<style>
  .activity-card {
    background: var(--box-inner-bg);
    border: 1px solid var(--colour-border);
    border-top: 4px solid var(--colour-accent);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .activity-card__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .activity-card__drawing {
    padding: 1rem 2rem 0;
  }

  .activity-card__body {
    padding: 1.5rem;
  }

  .activity-card__body p {
    margin: 0;
  }
</style>
